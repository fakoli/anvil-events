[Unit]
Description=anvil-events convergence agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anvil-events
Group=anvil-events
EnvironmentFile=/etc/anvil-events/events.env
ExecStart=/usr/local/bin/anvil-events --root /var/lib/anvil/events serve --config /etc/anvil-events/node.toml --durable node-events
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/anvil/events

[Install]
WantedBy=multi-user.target
